# GitHub access token — classic PAT with the `repo` and `workflow` scopes.
# Create one at https://github.com/settings/tokens/new
# When unset, tools fall back to the local `gh` CLI authentication.
GH_TOKEN=

# Repository used by all tools. Default: Uomocosa/lele-rust-projects
# GH_REPO=Uomocosa/lele-rust-projects

# Optional: override the game executable path used by launch_game.
# Default: <repo>/freenet_libp2p_bevy_example_1/target/ci/release/freenet-libp2p-bevy-example-1[.exe]
# FBX_GAME_EXE=/path/to/freenet-libp2p-bevy-example-1
