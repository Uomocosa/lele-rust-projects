{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "plan",
  "model": "opencode-go/kimi-k3",
  "compaction": {
    "auto": true
  },
  "instructions": [
    "/root/.config/opencode/skills/lele-syntax-rs/SKILL.md",
    "/root/.config/opencode/skills/opencode-git-workflow/SKILL.md"
  ],
  "permission": {
    "external_directory": {
      "*": "allow",
      "/**": "allow"
    },
    "skill": {
      "*": "deny",
      "opencode-*": "allow",
      "*-rs": "allow",
      "bevy": "allow",
      "libp2p": "allow",
      "freenet": "allow"
    }
  },
  "mcp": {
    "aai-tools": {
      "type": "local",
      "command": [
        "/home/uomocosa/Syncthing/[AAI] Agentic AI/rust_projects/projects/aai_mcp/target/release/aai-mcp"
      ],
      "enabled": true
    }
  },
  "provider": {
    "opencode-go": {
      "models": {
        "deepseek-v4-flash": {
          "variants": {
            "high": {
              "reasoningEffort": "Max"
            }
          }
        }
      }
    }
  }
}
