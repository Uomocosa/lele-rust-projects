{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "plan",
  "compaction": {
    "auto": true
  },
  "instructions": [
    "~/.config/opencode/skills/lele-rs/SKILL.md",
    "~/.config/opencode/skills/lele-syntax-rs/SKILL.md",
    "~/.config/opencode/skills/lele-lint-rs/SKILL.md",
    "~/.config/opencode/skills/opencode-git-workflow/SKILL.md",
    "~/.config/opencode/skills/itertools-rs/SKILL.md",
    "~/.config/opencode/skills/criterion-rs/SKILL.md",
    "~/.config/opencode/skills/rayon-rs/SKILL.md",
    "~/.config/opencode/skills/devenv-rs/SKILL.md",
    "~/.config/opencode/skills/cargo-nextest-rs/SKILL.md",
    "~/.config/opencode/skills/definition-function-taxonomy/SKILL.md"
  ],
  "permission": {
    "external_directory": {
      "*": "allow",
      "/**": "allow"
    },
    "skill": {
      "*": "deny",
      "opencode-*": "allow",
      "definition-*": "allow",
      "*-rs": "allow",
      "deskctrl": "allow",
      "crate-tag-ci": "allow",
      "libp2p": "allow",
      "freenet": "allow",
      "freenet-gateway": "allow",
      "freenet-contract-design": "allow"
    }
  },
  "mcp": {
    "deskctrl": {
      "type": "local",
      "command": [
        "/home/uomocosa/Syncthing/[AAI] Agentic AI/rust_projects/projects/deskctrl_mcp/target/release/deskctrl-mcp"
      ],
      "enabled": true,
      "environment": {
        "AAI_ARTIFACTS_DIR": "/home/uomocosa/Syncthing/[AAI] Agentic AI/rust_projects/projects/deskctrl_mcp/artifacts/freenet_bevy"
      }
    },
    "test-orchestrator": {
      "type": "local",
      "command": [
        "/home/uomocosa/Syncthing/[AAI] Agentic AI/rust_projects/projects/test_orchestrator_mcp/target/release/test-orchestrator-mcp"
      ],
      "enabled": true
    }
  }
}
