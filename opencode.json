{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "plan",
  "compaction": {
    "auto": true
  },
  "permissions": [
    { "action": "external_directory", "resource": "*", "effect": "allow" },
    { "action": "external_directory", "resource": "/**", "effect": "allow" },
    { "action": "skill", "resource": "*", "effect": "deny" },
    { "action": "skill", "resource": "opencode-*", "effect": "allow" },
    { "action": "skill", "resource": "definition-*", "effect": "allow" },
    { "action": "skill", "resource": "*-rs", "effect": "allow" },
    { "action": "skill", "resource": "crate-tag-ci", "effect": "allow" },
    { "action": "skill", "resource": "libp2p", "effect": "allow" },
    { "action": "skill", "resource": "freenet", "effect": "allow" }
  ]
}
